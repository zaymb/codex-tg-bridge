[Unit]
Description=Telegram transport bridge for Codex
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=tgbridge
Group=tgbridge
WorkingDirectory=/opt/codex-tg-bridge
EnvironmentFile=/etc/codex-tg-bridge/bridge.env
LoadCredential=telegram-token:/etc/codex-tg-bridge/telegram-token
Environment=TELEGRAM_TOKEN_FILE=/run/credentials/%n/telegram-token
ExecStart=/usr/local/bin/node /opt/codex-tg-bridge/src/transport-index.mjs
Restart=on-failure
RestartPreventExitStatus=78
RestartSec=5
TimeoutStopSec=30
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
LockPersonality=true
RestrictSUIDSGID=true
RestrictRealtime=true
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadOnlyPaths=/opt/codex-tg-bridge
ReadWritePaths=/var/lib/codex-tg-bridge /srv/codex-inbox
MemoryMax=256M
TasksMax=64

[Install]
WantedBy=multi-user.target
