# Production reads the token from this protected file. Do not commit the file.
TELEGRAM_TOKEN_FILE=/run/credentials/codex-tg-bridge.service/telegram-token
TELEGRAM_OWNER_USER_ID=123456789
TELEGRAM_ALLOWED_CHAT_IDS=-1001234567890
TELEGRAM_ALLOWED_CHANNEL_IDS=
TELEGRAM_CHAT_ALIASES={"sandbox":"-1001234567890"}

BRIDGE_SESSION_LABEL=tg-engage
BRIDGE_DB_PATH=/var/lib/codex-tg-bridge/bridge.sqlite3
BRIDGE_POLL_TIMEOUT_SEC=50
BRIDGE_UPDATE_LEASE_MS=120000
BRIDGE_DELIVER_ALL_GROUP_MESSAGES=false
BRIDGE_LOG_LEVEL=info
