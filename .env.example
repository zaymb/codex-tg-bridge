# Production reads the token from this protected file. Do not commit the file.
TELEGRAM_TOKEN_FILE=/run/credentials/codex-tg-bridge.service/telegram-token
TELEGRAM_OWNER_USER_ID=123456789
TELEGRAM_ALLOWED_CHAT_IDS=-1001234567890
TELEGRAM_ALLOWED_CHANNEL_IDS=
TELEGRAM_CHAT_ALIASES={"sandbox":"-1001234567890"}

APP_SERVER_SOCKET=/run/codex-tg/app/app.sock
BRIDGE_ACTION_SOCKET=/run/codex-tg/bridge/action.sock
BRIDGE_WAKE_SOCKET=/run/codex-tg/bridge/wake.sock
BRIDGE_DB_PATH=/var/lib/codex-tg-bridge/bridge.sqlite3
BRIDGE_ATTACHMENT_ROOT=/var/lib/codex-tg-bridge/attachments
BRIDGE_EXPORT_ROOTS=/srv/codex-workspace/exports

CODEX_WORKDIR=/srv/codex-workspace
CODEX_WRITABLE_ROOTS=/srv/codex-workspace
CODEX_MODEL=
CODEX_EFFORT=high
CODEX_CONTRACT_PATH=/opt/tg-engage/bridge/fixtures/codex-app-server-0.143.0/contract.json

BRIDGE_MAX_CONCURRENT_TURNS=2
BRIDGE_POLL_TIMEOUT_SEC=50
BRIDGE_TURN_TIMEOUT_MS=900000
BRIDGE_UPDATE_LEASE_MS=120000
BRIDGE_TYPING_INTERVAL_MS=4000
BRIDGE_LOG_LEVEL=info
